# Cylinder (8-point top and bottom rings)
# v1-v8 = top ring (y=1), v9-v16 = bottom ring (y=0)
# Each ring: phi = 0, 45, 90, 135, 180, 225, 270, 315

# Top ring (y=1)
v  1    1  0
v  0.7  1  0.7
v  0    1  1
v -0.7  1  0.7
v -1    1  0
v -0.7  1 -0.7
v  0    1 -1
v  0.7  1 -0.7

# Bottom ring (y=0)
v  1    0  0
v  0.7  0  0.7
v  0    0  1
v -0.7  0  0.7
v -1    0  0
v -0.7  0 -0.7
v  0    0 -1
v  0.7  0 -0.7

# Side panels (8 quads = 16 triangles)
f 1 2 10
f 1 10 9
f 2 3 11
f 2 11 10
f 3 4 12
f 3 12 11
f 4 5 13
f 4 13 12
f 5 6 14
f 5 14 13
f 6 7 15
f 6 15 14
f 7 8 16
f 7 16 15
f 8 1 9
f 8 9 16

# Top cap (fan from v1)
f 1 8 7
f 1 7 6
f 1 6 5
f 1 5 4
f 1 4 3
f 1 3 2

# Bottom cap (fan from v9)
f 9 10 11
f 9 11 12
f 9 12 13
f 9 13 14
f 9 14 15
f 9 15 16